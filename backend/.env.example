# Postgres
DATABASE_URL=postgres://tuuvo:tuuvo@postgres:5432/tuuvo

# Autenticação — DOIS segredos diferentes por design (ver middleware/auth.ts):
# um token de tuuvo_users nunca deve validar numa rota de tenant, e vice-versa.
JWT_SECRET_TENANT=troque-este-segredo-tenant-em-producao
JWT_SECRET_TUUVO=troque-este-outro-segredo-tuuvo-em-producao
JWT_EXPIRES_IN=8h

# Criptografia de credenciais de canal (32 bytes em base64)
CREDENTIALS_ENCRYPTION_KEY=troque-por-uma-chave-de-32-bytes-em-base64

# WhatsApp não-oficial — GTI (token vem do banco por conexão)
GTI_BASE_URL=https://api.gtiapi.workers.dev

# RCS — broker MKOM (SMS removido do escopo na v2)
MKOM_RCS_BASE_URL=https://sms.mkmservice.com/sms/api/transmission/v1

# Zernio — WhatsApp oficial + redes sociais, uma key só (platform_channel_providers)
ZERNIO_BASE_URL=https://zernio.com/api/v1

# E-mail — IMAP/SMTP (config real por conexão fica em channel_connections.config;
# essas variáveis são só fallback/exemplo de desenvolvimento)
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=

PUBLIC_BASE_URL=https://api.tuuvo.app.br
PORT=3000
